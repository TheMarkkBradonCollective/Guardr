{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/missed-checkins",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/push/subscribe.ts": {
      "maxDuration": 10
    },
    "api/push/unsubscribe.ts": {
      "maxDuration": 10
    },
    "api/push/test.ts": {
      "maxDuration": 10
    },
    "api/push/events.ts": {
      "includeFiles": "api/_push/**"
    },
    "api/push/send.ts": {
      "includeFiles": "api/_push/**"
    },
    "api/cron/missed-checkins.ts": {
      "includeFiles": "api/_push/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
