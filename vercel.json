{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run generate:logos && npm run generate:walkie-chirp && vite build && node scripts/bundle-push-handlers.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/missed-checkins",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/push/subscribe.ts": {
      "maxDuration": 10
    },
    "api/push/unsubscribe.ts": {
      "maxDuration": 10
    },
    "api/push/test.ts": {
      "maxDuration": 10
    },
    "api/push/events.ts": {
      "maxDuration": 15
    },
    "api/push/send.ts": {
      "maxDuration": 15
    },
    "api/cron/missed-checkins.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/|marketing/|download/).*)", "destination": "/index.html" }
  ]
}
