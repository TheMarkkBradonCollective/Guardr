{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run generate:logos && npm run generate:walkie-chirp && vite build && node scripts/bundle-push-handlers.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/missed-checkins",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/company-placard-expiry",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/pre-shift-briefings",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/push/subscribe.ts": {
      "maxDuration": 10
    },
    "api/push/unsubscribe.ts": {
      "maxDuration": 10
    },
    "api/push/test.ts": {
      "maxDuration": 10
    },
    "api/push/events.ts": {
      "maxDuration": 15
    },
    "api/push/send.ts": {
      "maxDuration": 15
    },
    "api/cron/missed-checkins.ts": {
      "maxDuration": 30
    },
    "api/cron/company-placard-expiry.ts": {
      "maxDuration": 30
    },
    "api/cron/pre-shift-briefings.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/|marketing/|download/|design-preview\\.html).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/download/guardr.apk",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/download/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
