{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run generate:logos && npm run generate:walkie-chirp && vite build && node scripts/bundle-push-handlers.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/missed-checkins",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/company-placard-expiry",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/pre-shift-briefings",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/push/subscribe.ts": {
      "maxDuration": 10
    },
    "api/push/unsubscribe.ts": {
      "maxDuration": 10
    },
    "api/push/test.ts": {
      "maxDuration": 10
    },
    "api/push/events.ts": {
      "maxDuration": 15
    },
    "api/push/send.ts": {
      "maxDuration": 15
    },
    "api/cron/missed-checkins.ts": {
      "maxDuration": 30
    },
    "api/cron/company-placard-expiry.ts": {
      "maxDuration": 30
    },
    "api/cron/pre-shift-briefings.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/manuals",
      "destination": "/manuals/Guardr-User-Manuals-Combined.pdf",
      "permanent": false
    },
    {
      "source": "/manuals/",
      "destination": "/manuals/Guardr-User-Manuals-Combined.pdf",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/download/guardr-client.apk", "destination": "/download/Guardr-Client.apk" },
    { "source": "/download/guardr-guard.apk", "destination": "/download/Guardr-Guard.apk" },
    { "source": "/download/guardr-staff.apk", "destination": "/download/Guardr-Staff.apk" },
    { "source": "/download/guardr-apps.zip", "destination": "/download/Guardr-All-APKs.zip" },
    { "source": "/((?!api/|marketing/|download/|manuals/|guardr\\.apk|version\\.json).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/guardr.apk",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"guardr.apk\"" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/download/guardr.apk",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"guardr.apk\"" }
      ]
    },
    {
      "source": "/download/Guardr-All-APKs.zip",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Guardr-All-APKs.zip\"" }
      ]
    },
    {
      "source": "/download/guardr-apps.zip",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Guardr-All-APKs.zip\"" }
      ]
    },
    {
      "source": "/download/Guardr-Client.apk",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Guardr-Client.apk\"" }
      ]
    },
    {
      "source": "/download/Guardr-Guard.apk",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Guardr-Guard.apk\"" }
      ]
    },
    {
      "source": "/download/Guardr-Staff.apk",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Guardr-Staff.apk\"" }
      ]
    },
    {
      "source": "/download/guardr-(client|guard|staff).apk",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    },
    {
      "source": "/download/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manuals/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
