# ─── Production (guardr.co on Vercel) ─────────────────────────
APP_URL=https://guardr.co
VITE_APP_URL=https://guardr.co

# ─── Supabase (Project Settings → API) ────────────────────────
# Frontend (safe to expose — Vercel env, prefix VITE_ for client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key

# Server only (Stripe webhooks / admin writes — NEVER expose publicly)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key
# Legacy alias (optional — same value as service_role key)
# SUPABASE_KEY=eyJ...your_service_role_key

# Legacy aliases (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Stripe (Dashboard → Developers) ──────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Web Push (VAPID) ─────────────────────────────────────────
# Generate keys: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@guardr.co
PUSH_INTERNAL_SECRET=

# ─── Android APK push (FCM) ───────────────────────────────────
# Preferred (Firebase HTTP v1): Project settings → Service accounts → Generate new private key
# Paste the full JSON as one line into Vercel:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FCM_SERVICE_ACCOUNT_JSON=
# Legacy only — skip if Cloud Messaging API (Legacy) is disabled in Firebase:
# FCM_SERVER_KEY=
# Also place google-services.json in android/app/ before building the APK.

# Vercel Cron / server-side scheduled jobs (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Optional override for POST /api/admin/apply-schema (falls back to CRON_SECRET / AUTH_BRIDGE_SECRET)
# SCHEMA_APPLY_SECRET=

# Database URL is required for that endpoint to run DDL (PostgREST cannot ALTER TABLE)
# DATABASE_URL=postgresql://postgres:...@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_ACCESS_TOKEN=  # alternative: Supabase Management API personal access token


# ─── Error monitoring (optional) ─────────────────────────────
VITE_SENTRY_DSN=

# ─── Experience tiers (optional overrides) ───────────────────
# PWA: full (default) | lite — also auto-detects saveData / 2G / low memory
# VITE_PWA_EXPERIENCE=full
# APK: full (phones default) | premium (tablets default)
# VITE_APK_EXPERIENCE=full

# ─── Square (Dashboard → Developers) ─────────────────────────
SQUARE_ACCESS_TOKEN=sq0atp-...
SQUARE_APPLICATION_ID=sq0idp-...
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ─── SMS notifications (optional — Twilio) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Background checks (optional — Checkr) ───────────────────
CHECKR_API_KEY=

# ─── Insurance verification (optional — automated COI API) ───
INSURANCE_VERIFICATION_API_KEY=

# ─── Local dev only ───────────────────────────────────────────
# APP_URL=http://localhost:3000
# VITE_APP_URL=http://localhost:3000
