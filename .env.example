# ─── Production (guardr.co on Vercel) ─────────────────────────
APP_URL=https://guardr.co
VITE_APP_URL=https://guardr.co

# ─── Supabase (Project Settings → API) ────────────────────────
# Frontend (safe to expose — Vercel env, prefix VITE_ for client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key

# Server only (Stripe webhooks / admin writes — NEVER expose publicly)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# Legacy aliases (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Stripe (Dashboard → Developers) ──────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Local dev only ───────────────────────────────────────────
# APP_URL=http://localhost:3000
# VITE_APP_URL=http://localhost:3000
