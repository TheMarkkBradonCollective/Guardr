# Guardr — Neon + Cloudflare Worker (local / CI / Wrangler secrets)

# App origin (Vite client + Capacitor WebView). Production Worker URL until custom domain:
APP_URL=https://guardr.themarkkbrandoncollective-2d9.workers.dev
VITE_APP_URL=https://guardr.themarkkbrandoncollective-2d9.workers.dev

# Neon Postgres (server / Worker secrets — never VITE_)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/guardr?sslmode=require
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/guardr?sslmode=require

# Worker auth
JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Web Push (VAPID) — generate: npm run generate:vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@guardr.co
PUSH_INTERNAL_SECRET=

# Cron routes (Authorization: Bearer)
CRON_SECRET=

# Optional schema migrate (POST /api/admin/apply-schema)
SCHEMA_APPLY_SECRET=

# Android FCM (APK native push)
FCM_SERVICE_ACCOUNT_JSON=

# Square (optional)
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Twilio / Checkr / insurance API (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CHECKR_API_KEY=
INSURANCE_VERIFICATION_API_KEY=

# Seed admin (npm run db:seed — direct Neon URL required)
STAFF_ADMIN_EMAIL=admin@guardr.co
STAFF_ADMIN_PASSWORD=

# Sentry (optional)
VITE_SENTRY_DSN=

# Local Worker dev
# wrangler dev loads secrets from .dev.vars (same keys as above, no VITE_ on secrets)
