# ─── Production (guardr.co on Vercel) ─────────────────────────
APP_URL=https://guardr.co
VITE_APP_URL=https://guardr.co

# ─── Supabase (Project Settings → API) ────────────────────────
# Frontend (safe to expose — Vercel env, prefix VITE_ for client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key

# Server only (Stripe webhooks / admin writes — NEVER expose publicly)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key
# Legacy alias (optional — same value as service_role key)
# SUPABASE_KEY=eyJ...your_service_role_key

# Legacy aliases (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Stripe (Dashboard → Developers) ──────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Web Push (VAPID) ─────────────────────────────────────────
# Generate keys: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@guardr.co
PUSH_INTERNAL_SECRET=

# ─── Android APK push (FCM) ───────────────────────────────────
# Preferred (Firebase HTTP v1): Project settings → Service accounts → Generate new private key
# Paste the full JSON as one line into Vercel:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FCM_SERVICE_ACCOUNT_JSON=
# Legacy only — skip if Cloud Messaging API (Legacy) is disabled in Firebase:
# FCM_SERVER_KEY=
# Also place google-services.json in android/app/ before building the APK.

# Vercel Cron / server-side scheduled jobs (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ─── Error monitoring (optional) ─────────────────────────────
VITE_SENTRY_DSN=

# ─── SMS notifications (optional — Twilio) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Background checks (optional — Checkr) ───────────────────
CHECKR_API_KEY=

# ─── Local dev only ───────────────────────────────────────────
# APP_URL=http://localhost:3000
# VITE_APP_URL=http://localhost:3000
