# Copy to android/keystore.properties and fill in your Play upload keystore.
# Never commit keystore.properties or *.keystore to git.
#
# Generate a keystore (run once, back up the file and passwords):
#   keytool -genkeypair -v \
#     -keystore secrets/guardr-upload.keystore \
#     -alias guardr-upload \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Signature Security Specialist LLC, OU=Mobile, O=Signature Security Specialist LLC, ST=California, C=US"
#
storeFile=../secrets/guardr-upload.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=guardr-upload
keyPassword=YOUR_KEY_PASSWORD
